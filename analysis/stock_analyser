from data.downloader import download_stock_data
from data.cleaner import clean_stock_data

from indicators.trend import (
    add_trend_indicators
)

from indicators.momentum import (
    add_rsi,
    add_macd
)

from indicators.volatility import (
    add_bollinger_bands,
    add_atr,
    add_volatility
)

from indicators.volume import (
    add_volume_indicators
)

from strategies.combined import (
    generate_signals
)

from backtesting.engine import (
    BacktestEngine
)

from backtesting.metrics import (
    calculate_metrics
)


class StockAnalyzer:

    def __init__(
        self,
        initial_capital=100_000,
        transaction_cost=0.001,
        slippage=0.0005,
        risk_free_rate=0.06
    ):

        self.initial_capital = initial_capital

        self.transaction_cost = (
            transaction_cost
        )

        self.slippage = slippage

        self.risk_free_rate = (
            risk_free_rate
        )

    def prepare_data(
        self,
        symbol,
        start_date,
        end_date
    ):

        data = download_stock_data(
            symbol,
            start_date,
            end_date
        )

        data = clean_stock_data(data)

        # Indicators
        data = add_trend_indicators(data)

        data = add_rsi(data)

        data = add_macd(data)

        data = add_bollinger_bands(data)

        data = add_atr(data)

        data = add_volatility(data)

        data = add_volume_indicators(data)

        # Signals
        data = generate_signals(data)

        return data

    def analyze(
        self,
        symbol,
        start_date,
        end_date
    ):

        data = self.prepare_data(
            symbol,
            start_date,
            end_date
        )

        engine = BacktestEngine(
            initial_capital=self.initial_capital,
            transaction_cost=self.transaction_cost,
            slippage=self.slippage
        )

        results = engine.run(data)

        metrics = calculate_metrics(
            results,
            risk_free_rate=self.risk_free_rate
        )

        return results, metrics
